{
  "expo": {
    "name": "kickify",
    "slug": "kickify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/kickify/logo_app.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/kickify/logo_only.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/kickify/logo_only.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.kickyfi.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-localization",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "27b70d13-d3b5-44e1-89ef-9878c60fcdbf"
      }
    }
  }
}
