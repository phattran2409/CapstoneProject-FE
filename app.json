{
  "expo": {
    "name": "kickify",
    "slug": "kickify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/kickify/logo_app.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/kickify/logo_only.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kickify.app",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/kickify/logo_only.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.kickify.app",
      "googleServicesFile": "./google-services.json"
    },
    "scheme": "kickify",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-localization",
      "expo-asset",
      "expo-font",
      [
        "@react-native-firebase/app",
        {
          "android": {
            "googleServicesFile": "./google-services.json"
          },
          "ios": {
            "googleServicesFile": "./GoogleService-Info.plist"
          }
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them.",
          "cameraPermission": "The app accesses your camera to let you take photos."
        }
      ],
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ứng dụng cần vị trí của bạn để tìm sân bóng gần bạn theo bán kính.",
          "locationAlwaysAndWhenInUsePermission": "Ứng dụng cần vị trí để hiển thị sân bóng trong bán kính bạn chọn."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "27b70d13-d3b5-44e1-89ef-9878c60fcdbf"
      },
      "googleWebClientId": "600662709460-m0tclu997im6r5qliinv06hj7ut542ag.apps.googleusercontent.com"
    }
  }
}
